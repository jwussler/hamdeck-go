dist
bin
hamdeck-host
*.deb
client/.dart_tool
client/lib
client/assets
client/linux
client/macos
client/windows
client/build/linux
client/build/flutter_assets
client/build/native_assets
client/build/test_cache
client/build/unit_test_assets
client/build/web-shoot
client-wasm
docs
