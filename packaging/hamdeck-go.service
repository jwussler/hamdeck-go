[Unit]
Description=HamDeck station host (Go)
Documentation=https://github.com/jwussler/hamdeck-go
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/etc/hamdeck-go/env
ExecStart=/opt/hamdeck-go/bin/hamdeck-host     --radio /dev/ttyRIG --radio-baud 38400     --audio codec     --tgxl 192.168.40.51 --tgxl-port 9010     --record-dir /var/lib/hamdeck-go/recordings --replay-seconds 60     --panel /opt/hamdeck-go/panel     --port 5102 --control-port 5101
Restart=on-failure
RestartSec=3
# ⚠️ NO DeviceAllow= here. Listing one device implicitly whitelists ONLY that
# device, which silently blocked /dev/snd and the host died on the sound card
# with a permissions error that looked like a broken codec. Group membership is
# what actually grants access to both the serial bridge and the audio device.
SupplementaryGroups=audio dialout

[Install]
WantedBy=multi-user.target
